# Midnight Aegis Environment Configuration
# Copy this file to .env and adjust variables as needed

# Network Selection: 'testnet-remote', 'devnet-local', or 'standalone'
VITE_MIDNIGHT_NETWORK=testnet-remote

# Midnight Substrate Indexer GraphQL Endpoint
VITE_INDEXER_URL=https://indexer.testnet.midnight.network/api/v1/graphql

# Midnight Local / Remote Proof Server
VITE_PROOF_SERVER_URL=http://localhost:6300

# Deployed Aegis Compact Contract Address
VITE_CONTRACT_ADDRESS=0x7f4a21c99fbd8e32c842b10a9901ef45b23d91ae5c7b39d10e82f4410a82b991

# Default Public Verification Threshold (Years)
VITE_DEFAULT_AGE_THRESHOLD=18
